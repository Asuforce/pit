default: &default
  adapter: mysql2
  encoding: utf8mb4
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  username: pit_user
  password: pit_password
  host: mysql

development:
  <<: *default
  database: pit_development

test:
  <<: *default
  database: pit_test

production:
  <<: *default
  database: pit_production
  username: pit_user
  password: <%= ENV['DATABASE_PASSWORD'] %>
  host: <%= ENV['DATABASE_HOST'] %>
